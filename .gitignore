# Dependencies
node_modules/
.pnp
.pnp.js

# Production build outputs
dist/
build/
out/

# Environment files - NEVER commit real credentials
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Allow example files
!.env.example
!apps/*/.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Coverage directory
coverage/
*.lcov

# Editor and OS files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Temporary and cache directories
.eslintcache
.stylelintcache
*.tsbuildinfo
.turbo
tmp/
temp/
