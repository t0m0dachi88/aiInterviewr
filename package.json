{
  "name": "technical-hiring-platform",
  "version": "0.1.0",
  "private": true,
  "description": "AI-Powered Technical Hiring Platform Monorepo",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"api,web\" -c \"cyan,magenta\" \"npm run dev --workspace=@platform/api\" \"npm run dev --workspace=@platform/web\"",
    "dev:api": "npm run dev --workspace=@platform/api",
    "dev:web": "npm run dev --workspace=@platform/web",
    "dev:worker": "npm run dev --workspace=@platform/worker",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{js,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,ts,tsx,json,md}\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.5.1"
  }
}
