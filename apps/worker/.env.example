# ==============================================================================
# Execution Worker Service Environment Configuration
# ==============================================================================

NODE_ENV=development

# Upstash Redis Managed Cloud Instance (with TLS)
# Must connect to the same Upstash Redis instance as the API
WORKER_REDIS_HOST=your-database.upstash.io
WORKER_REDIS_PORT=6379
WORKER_REDIS_PASSWORD=your_upstash_password
WORKER_REDIS_TLS=true

# Alternative REDIS_URL format
# WORKER_REDIS_URL=rediss://default:your_upstash_password@your-database.upstash.io:6379

# Worker Concurrency limit for BullMQ
WORKER_CONCURRENCY=5
