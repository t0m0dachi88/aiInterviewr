# ==============================================================================
# API Service Environment Configuration
# ==============================================================================

PORT=5000
NODE_ENV=development

# MongoDB Atlas Managed Database Connection URI
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/technical_hiring_platform?retryWrites=true&w=majority

# Upstash Redis Managed Cloud Instance (with TLS)
# From Upstash Console -> Database Details -> Connect with ioredis
UPSTASH_REDIS_HOST=your-database.upstash.io
UPSTASH_REDIS_PORT=6379
UPSTASH_REDIS_PASSWORD=your_upstash_password
UPSTASH_REDIS_TLS=true

# Alternative REDIS_URL format is also accepted:
# REDIS_URL=rediss://default:your_upstash_password@your-database.upstash.io:6379

# Allowed CORS Origin for web frontend
CORS_ORIGIN=http://localhost:5173

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info
