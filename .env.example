# ==============================================================================
# AI-Powered Technical Hiring Platform - Managed Infrastructure Environment Example
# Copy this file to .env in local development. Never commit real credentials!
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend API Service (apps/api)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# MongoDB Atlas Managed Cloud Database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/technical_hiring_platform?retryWrites=true&w=majority

# Upstash Redis Managed Cloud Instance (with TLS)
# Obtain these from your Upstash Console: https://console.upstash.com/
UPSTASH_REDIS_HOST=your-database.upstash.io
UPSTASH_REDIS_PORT=6379
UPSTASH_REDIS_PASSWORD=your_upstash_password
UPSTASH_REDIS_TLS=true

# Alternative single connection URI (also supported):
# REDIS_URL=rediss://default:your_upstash_password@your-database.upstash.io:6379

# Allowed CORS Origin for web frontend
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Frontend Web App (apps/web)
# Note: Database and Redis credentials must NEVER be exposed here!
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api/v1

# ------------------------------------------------------------------------------
# Execution Worker Service (apps/worker - Standalone Deployed Service)
# ------------------------------------------------------------------------------
# In production, worker consumes jobs from the same Upstash Redis instance
WORKER_REDIS_HOST=your-database.upstash.io
WORKER_REDIS_PORT=6379
WORKER_REDIS_PASSWORD=your_upstash_password
WORKER_REDIS_TLS=true
WORKER_CONCURRENCY=5
